<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Links Css -->
    <link rel="stylesheet" href="../styles/global.css">
    <link rel="stylesheet" href="../styles/navBar.css">
    <link rel="stylesheet" href="../styles/footer.css">
    <link rel="stylesheet" href="../styles/cadastroPerfilColaborador.css">
    <link rel="stylesheet" href="../styles/carregamentoImagem.css">

    <!-- Links JS -->
    <script src="../scripts/campoImagem.js" defer></script> 
    <script src="../scripts/mascaraCep.js" defer></script>
    <script src="../scripts/mascaraCPF-CNPJ.js" defer></script>
    <script src="../scripts/validaCep.js" defer></script>


    <!-- CDN font-awesome e Google Fontes-->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <title>Configuração do Perfil Profissional - ConnectaServ</title>
</head>

<body>
    <section class="container">

        <%- include('./partials/headerColaborador') %>

        <main class="box register-page">
            <div class="register-container">
                <div class="register-header">
                    <h2>Configure seu Perfil Profissional</h2>
                    <p>Complete as informações abaixo para aparecer nas buscas e atrair clientes.</p>
                </div>

                <form action="/cadastro-prestador" method="POST" enctype="multipart/form-data" class="register-form">
                    
                    <!-- SEÇÃO: MÍDIAS DO PERFIL -->
                    <div class="form-section">
                        <h3><i class="fa-solid fa-camera"></i> Identidade Visual e Portfólio</h3>
                        <div class="media-upload-grid">
                            
                            <!-- Foto de Perfil -->
                             <div class="form-group">
                                <label>Foto de Perfil</label>
                                <div class="file-drop-area">
                                    <i class="fa-solid fa-user-plus upload-icon"></i>
                                    <span class="file-msg">Selecionar foto de perfil</span>

                                    <div class="previews-wrapper"></div>

                                    <input
                                        type="file"
                                        name="foto_perfil"
                                        accept="image/*"
                                        class="file-input">
                                </div>
                            </div>

                            <!-- Fotos/Vídeos do Portfólio -->
                            <div class="form-group">
                                <label>Galeria do Portfólio (Fotos e Vídeos)</label> 
                                <div class="file-drop-area">
                                    <i class="fa-solid fa-images upload-icon"></i>
                                    <div class="previews-wrapper"></div>
                                    <span class="file-msg">Arraste ou selecione mídias dos seus trabalhos</span>
                                    <input type="file" name="portfolio_midias" accept="image/*,video/*" multiple class="file-input">

                                    <div class="contador-imagem">
                                        <p id="numero-fotos-upada"> 0 </p>
                                        <p> / 4</p>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>

                    <div class="section-divider"></div>

                    <!-- SEÇÃO: INFORMAÇÕES PROFISSIONAIS -->
                    <div class="form-section">
                        <h3><i class="fa-solid fa-briefcase"></i> Atuação Profissional</h3>
                        <div class="form-grid text-3-columns">
                            <div class="form-group">
                                <label for="documento">CPF ou CNPJ</label>
                                <input type="text" id="documento" name="documento" placeholder="000.000.000-00" required>
                            </div>
                            <div class="form-group">
                                <label for="categoria">Categoria Principal</label>
                                <select id="categoria" name="categoria" required>
                                    <option value="" disabled selected>Selecione</option>
                                    <option value="reformas">Reformas</option>
                                    <option value="eletrica">Elétrica</option>
                                    <option value="beleza">Beleza</option>
                                    <option value="aulas">Aulas</option>
                                    <option value="aulas">Infromática</option>
                                    <option value="aulas">Outras</option>  
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="cargo">Sua Especialidade</label>
                                <input type="text" id="cargo" name="cargo" placeholder="Ex: Pintora Decorativa" required>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="bio">Sobre Mim (Biografia para o perfil)</label>
                            <textarea id="bio" name="bio" rows="4" placeholder="Conte detalhes da sua experiência, certificações e histórico de atendimento..." required></textarea>
                        </div>
                    </div>

                    <div class="section-divider"></div>

                    <!-- SEÇÃO: LOCALIZAÇÃO -->
                    <div class="form-section">
                        <h3><i class="fa-solid fa-location-dot"></i> Região de Atendimento</h3>
                        <div class="form-grid text-3-columns">
                            <div class="form-group">
                                <label for="cep">CEP</label>
                                <input type="text" id="cep" name="cep" placeholder="50000-000" required>
                            </div>
                            <div class="form-group">
                                <label for="cidade">Cidade</label>
                                <input type="text" id="cidade" name="cidade" placeholder="Ex: Recife" required>
                            </div>
                            <div class="form-group">
                                <label for="estado">Estado (UF)</label>
                                <input type="text" id="estado" name="estado" placeholder="Ex: PE" maxlength="2" required>
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="raio">Raio Máximo de Deslocamento (em km)</label>
                            <input type="number" id="raio" name="raio" placeholder="Ex: 15" min="1" required>
                        </div>
                    </div>

                    <div class="section-divider"></div>

                    <!-- SEÇÃO: TABELA DE PREÇOS (Alinha com o profile.ejs) -->
                    <div class="form-section">
                        <h3><i class="fa-solid fa-money-bill-wave"></i> Tabela de Preços e Serviços</h3>
                        <p class="section-subtitle">Defina o seu preço de entrada e liste os serviços mais comuns para exibição no seu card lateral.</p>
                        
                        <div class="form-group base-price-input-wrapper">
                            <label for="preco_base">Preço Base (A partir de R$)</label>
                            <div class="currency-input">
                                <span>R$</span>
                                <input type="number" id="preco_base" name="preco_base" placeholder="80" min="0" required>
                            </div>
                        </div>

                        <div class="services-price-list">
                            <label>Serviços Adicionais (Opcional - Máximo 4)</label>
                            
                            <!-- Linha de Serviço 1 -->
                            <div class="service-row">
                                <input type="text" name="servico_nome[]" placeholder="Ex: Visita Técnica / Troca de Torneira">
                                <div class="currency-input small-input">
                                    <span>R$</span>
                                    <input type="number" name="servico_valor[]" placeholder="150" min="0">
                                </div>
                            </div>

                            <!-- Linha de Serviço 2 -->
                            <div class="service-row">
                                <input type="text" name="servico_nome[]" placeholder="Ex: Detecção de Vazamento">
                                <div class="currency-input small-input">
                                    <span>R$</span>
                                    <input type="number" name="servico_valor[]" placeholder="250" min="0">
                                </div>
                            </div>

                            <!-- Linha de Serviço 3 -->
                            <div class="service-row">
                                <input type="text" name="servico_nome[]" placeholder="Ex: Desentupimento de Pia">
                                <div class="currency-input small-input">
                                    <span>R$</span>
                                    <input type="number" name="servico_valor[]" placeholder="180" min="0">
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- <div class="section-divider"></div>
                         <div class="form-group">
                            <label for="pixCarteira"><i class="fa-brands fa-pix"></i> Informe sua chave PIX para o envio do valor na carteira:</label>
                            <input type="text" id="pixCarteira" name="pixCarteira" placeholder="Ex: 14.123.456/0001-12" min="1" required>
                        </div> -->
                    <div class="form-section"></div>

                    <div class="form-actions">
                        <button type="submit" class="btn-primary">Finalizar Meu Perfil <i class="fa-solid fa-check"></i></button>
                    </div>
                </form>
            </div>
        </main>

        <%- include('./partials/footer') %>
    </section>
</body>

</html>
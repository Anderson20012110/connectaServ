                                        <label>CVV</label>
                                        <input type="password" name="cartaoCVV[]" placeholder="123">
                                    </div>
                                </div>
                            </div>
                        </div>

                        <button type="button" id="btnAdicionarCartao" style="color: var(--color-primary); font-weight: 600; display: flex; align-items: center; gap: 8px; padding: 10px 0;">
                            <i class="fa-solid fa-plus"></i> Adicionar Outro Cartão
                        </button>
                    </div> -->

                    <div class="section-divider"></div>

                    <div class="form-actions">
                        <button type="submit" class="btn-primary">Criar Conta <i class="fa-solid fa-check"></i></button>
                    </div>

                </form>
            </div>
        </main>

    </div>


    <%- include ('./partials/footer') %>
</body>

</html>
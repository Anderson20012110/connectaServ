<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cadastro de Usuário</title>

    <link rel="stylesheet" href="../styles/global.css">
    <link rel="stylesheet" href="../styles/navBar.css">
    <link rel="stylesheet" href="../styles/footer.css">
    <link rel="stylesheet" href="../styles/cadastroPerfilColaborador.css">
    <link rel="stylesheet" href="../styles/carregamentoImagem.css">

    <!-- Links JS -->
    <script src="../scripts/campoImagem.js" defer></script> 
    <script src="../scripts/mascaraCep.js" defer></script>
    <script src="../scripts/mascaraDados.js" defer></script>
    <script src="../scripts/validaCep.js" defer></script>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body>
    <section class="container">
        
        <%- include('./partials/headerCliente') %>

        <main class="box register-page">
            <div class="register-container">
                <div class="register-header">
                    <h2>Cadastro de Usuário</h2>
                    <p>Preencha as informações abaixo para criar sua conta e acessar nossos serviços.</p>
                </div>

                <form action="/cadastroPrefilUsuario" method="POST" enctype="multipart/form-data" class="register-form">

                    <div class="form-section">
                        <h3><i class="fa-solid fa-camera"></i> Identidade Visual</h3>
                        <div class="media-upload-grid" style="grid-template-columns: 1fr;">
                            <div class="form-group">
                                <label>Foto de Perfil</label>
                                <div class="file-drop-area">
                                    <i class="fa-solid fa-user-plus upload-icon"></i>
                                    <span class="file-msg">Selecionar foto de perfil</span>
                                    <div class="previews-wrapper"></div>
                                    <input type="file" id="fotoPerfil" name="foto_perfil" accept="image/*" class="file-input">
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="section-divider"></div>

                    <div class="form-section">
                        <h3><i class="fa-solid fa-id-card"></i> Dados Pessoais</h3>
                        <div class="form-grid" style="grid-template-columns: repeat(2, 1fr);">
                            <div class="form-group">
                                <label>Nome Completo</label>
                                <input type="text" name="nome" placeholder="Digite seu nome completo" required>
                            </div>
                            <div class="form-group">
                                <label>CPF</label>
                                <input type="text" id="documento" maxlength="14" name="cpf" placeholder="000.000.000-00" required>
                            </div>
                            <div class="form-group">
                                <label>RG</label>
                                <input type="text" id="rg" maxlength="9" name="rg" placeholder="0.000.000" required>
                            </div>
                            <div class="form-group">
                                <label>Data de Nascimento</label>
                                <input type="date" name="dataNascimento" required>
                            </div>
                        </div>
                    </div>

                    <div class="section-divider"></div>

                    <div class="form-section">
                        <h3><i class="fa-solid fa-location-dot"></i> Endereço</h3>
                        <div class="form-grid text-3-columns">
                            <div class="form-group">
                                <label>CEP</label>
                                <input type="text" name="cep" id="cep" placeholder="00000-000" required>
                            </div>
                            <div class="form-group">
                                <label for="cidade">Cidade</label>
                                <input type="text" id="cidade" name="cidade" placeholder="Ex: Recife" required>
                            </div>
                            <div class="form-group">
                                <label for="estado">Estado (UF)</label>
                                <input type="text" id="estado" name="estado" placeholder="Ex: PE" maxlength="2" required>
                            </div>
                        </div>
                        <div class="form-grid" style="grid-template-columns: repeat(2, 1fr);">
                            <div class="form-group">
                                <label>Rua</label>
                                <input type="text" name="rua" required>
                            </div>
                            <div class="form-group">
                                <label>Bairro</label>
                                <input type="text" name="bairro" required>
                            </div>
                            <div class="form-group">
                                <label>Número</label>
                                <input type="text" name="numero" required>
                            </div>
                            <div class="form-group">
                                <label>Complemento</label>
                                <input type="text" name="complemento" placeholder="Apto, Bloco, etc (Opcional)">
                            </div>
                        </div>
                    </div>

                    <!-- <div class="section-divider"></div>

                    <div class="form-section">
                        <h3><i class="fa-solid fa-wallet"></i> Carteira Digital</h3>
                        <p class="section-subtitle">Adicione um método de pagamento para facilitar suas contratações.</p>
                        
                        <div id="walletContainer">
                            <div class="wallet-card" style="border: 1px solid var(--color-border); padding: 20px; border-radius: 8px; margin-bottom: 15px; background-color: #fafafa;">
                                <div class="form-grid" style="grid-template-columns: repeat(2, 1fr);">
                                    <div class="form-group">
                                        <label>Nome no Cartão</label>
                                        <input type="text" name="cartaoNome[]" placeholder="Como impresso no cartão">
                                    </div>
                                    <div class="form-group">
                                        <label>Número do Cartão</label>
                                        <input type="text" name="cartaoNumero[]" placeholder="0000 0000 0000 0000">
                                    </div>
                                    <div class="form-group">
                                        <label>Validade</label>
                                        <input type="text" name="cartaoValidade[]" placeholder="MM/AA">

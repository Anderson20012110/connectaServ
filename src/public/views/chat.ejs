<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Links Css -->
    <link rel="stylesheet" href="../styles/chat.css">
    <link rel="stylesheet" href="../styles/global.css">
    <link rel="stylesheet" href="../styles/navBar.css">
    <link rel="stylesheet" href="../styles/footer.css">
    
    <!-- Links Js -->
    <script type="module" src="./scripts/menuLateral.js" defer></script>
    
    <!-- CDN font-awesome e Google Fontes-->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <title>ConectaServ - Mensagens</title>
</head>

<body>

    <section class="container">
        <% if (usuario && usuario.perfil === 'cliente') { %>
            <%- include('partials/headerCliente') %>
        <% } else if (usuario && usuario.perfil === 'prestador') { %>
            <%- include('partials/headerColaborador') %>
        <% } else { %>
            <p><a href="/login">Por favor, faça login para acessar.</a></p>
        <% } %>

        <main class="chat-container">

            <aside class="chat-sidebar">
                <div class="chat-sidebar-header">
                    <h2>Mensagens</h2>
                    <div class="chat-search">
                        <input type="text" placeholder="Buscar conversas...">
                    </div>
                </div>

                <div class="chat-list">
                    <div class="chat-item active">
                        <div class="avatar-wrapper">
                            <div class="avatar text-avatar bg-blue">J</div>
                            <span class="online-indicator"></span>
                        </div>
                        <div class="chat-info">
                            <div class="chat-item-header">
                                <h4>João da Silva</h4>
                                <span class="time active-time">10:45</span>
                            </div>
                            <p>Certo, consigo ver. Pelo que notei...</p>
                        </div>
                    </div>

                    <div class="chat-item">
                        <div class="avatar-wrapper">
                            <div class="avatar text-avatar bg-gray">M</div>
                        </div>
                        <div class="chat-info">
                            <div class="chat-item-header">
                                <h4>Maria Oliveira</h4>
                                <span class="time">Ontem</span>
                            </div>
                            <p>Obrigado pelo serviço!</p>
                        </div>
                    </div>

                    <div class="chat-item">
                        <div class="avatar-wrapper">
                            <div class="avatar text-avatar bg-gray">M</div>
                        </div>
                        <div class="chat-info">
                            <div class="chat-item-header">
                                <h4>Maria Oliveira</h4>
                                <span class="time">Ontem</span>
                            </div>
                            <p>Obrigado pelo serviço!</p>
                        </div>
                    </div>

                    <div class="chat-item">
                        <div class="avatar-wrapper">
                            <div class="avatar text-avatar bg-gray">M</div>
                        </div>
                        <div class="chat-info">
                            <div class="chat-item-header">
                                <h4>Maria Oliveira</h4>
                                <span class="time">Ontem</span>
                            </div>
                            <p>Obrigado pelo serviço!</p>
                        </div>
                    </div>
                </div>
            </aside>

            <section class="chat-view">
                <header class="chat-header">
                    <div class="chat-user-info">
                        <div class="avatar text-avatar bg-blue">J</div>
                        <div>
                            <h3>João da Silva</h3>
                            <span class="status"><span class="status-dot"></span> Online agora</span>
                        </div>
                    </div>
                    <div class="chat-actions-top">
                        <button><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <path
                                    d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z">
                                </path>
                            </svg></button>
                        <button><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <polygon points="23 7 16 12 23 17 23 7"></polygon>
                                <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
                            </svg></button>
                        <button><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <circle cx="12" cy="12" r="1"></circle>
                                <circle cx="12" cy="5" r="1"></circle>
                                <circle cx="12" cy="19" r="1"></circle>
                            </svg></button>
                    </div>
                </header>

                <div class="chat-messages-area">
                </div>

                <footer class="chat-footer-area">
                    <div class="budget-action">
                        <button class="btn-budget">Criar orçamento personalizado</button>
                    </div>

                    <div class="chat-input-wrapper">
                        <button class="btn-attach">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--text-gray)"
                                stroke-width="2">
                                <path
                                    d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48">
                                </path>
                            </svg>
                        </button>

                        <input type="text" placeholder="Digite sua mensagem..." class="message-input">

                        <button class="btn-send">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <line x1="22" y1="2" x2="11" y2="13"></line>
                                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                            </svg>
                        </button>
                    </div>
                </footer>
            </section>

        </main>

        <%- include ('./partials/footer') %>
    </section>
</body>

</html>
<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Links Css -->
    <link rel="stylesheet" href="../styles/dashboard.css">
    <link rel="stylesheet" href="styles/global.css">
    <link rel="stylesheet" href="styles/navBar.css">
    <link rel="stylesheet" href="styles/footer.css">

    <!-- Links Js -->
    <script type="module" src="./scripts/menuLateral.js" defer></script>

    <!-- CDN font-awesome e Google Fontes-->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <title>Notificação</title>

</head>

<body>
    <section class="container">

            <% if (usuario && usuario.perfil === 'cliente') { %>
                <%- include('partials/headerCliente') %>
            <% } else if (usuario && usuario.perfil === 'prestador') { %>
                <%- include('partials/headerColaborador') %>
            <% } else { %>
                <p><a href="/login">Por favor, faça login para acessar.</a></p>
            <% } %>

        <main class="dashboard-container">

            <header class="dashboard-header">
                <div class="header-top">
                    <div class="header-titles">
                        <h1>Painel do Profissional</h1>
                        <p>Bem-vindo de volta, Carlos.</p>
                    </div>
                    <div class="header-actions">
                        <button class="btn-outline-white">Mensagens</button>
                        <button class="btn-outline-white"><i class="fa-solid fa-gear"></i> Configurar Perfil</button>
                    </div>
                </div>

                <div class="stats-grid">
                    <div class="stat-card">
                        <span class="stat-title">Nota</span>
                        <div class="stat-value">4.5 <span class="stat-sub">/ 5</span></div>
                    </div>
                    <div class="stat-card">
                        <span class="stat-title">Avaliação</span>
                        <div class="stat-value">124</div>
                    </div>
                    <div class="stat-card">
                        <span class="stat-title">Concluídos</span>
                        <div class="stat-value">321</div>
                    </div>
                    <div class="stat-card">
                        <span class="stat-title">Ganhos (Mês)</span>
                        <div class="stat-value">R$ 3.652,32</div>
                    </div>
                </div>
            </header>

            <section class="notification-banner">
                <div class="notif-icon">
                    <i class="fa-regular fa-bell"></i>
                </div>
                <div class="notif-content">
                    <h4>Novo pedido de orçamento</h4>
                    <p>João Silva enviou uma mensagem solicitando um orçamento para Troca de Sifão.</p>
                </div>
                <button class="btn-primary-small">Ver Mensagem</button>
            </section>

            <section class="jobs-section">
                <div class="jobs-header">
                    <h2>Meus Trabalhos</h2>
                    <p>Gerencie seus pedidos em andamento</p>
                </div>

                <div class="table-container">
                    <table class="jobs-table">
                        <thead>
                            <tr>
                                <th>ID / Serviço</th>
                                <th>Cliente</th>
                                <th>Data</th>
                                <th>Status</th>
                                <th>Valor</th>
                                <th>Ação</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    <strong>Troca de Sifão</strong>
                                    <span class="job-id">JOB-101</span>
                                </td>
                                <td>João Silva</td>
                                <td>Hoje, 14:00</td>
                                <td><span class="status-badge status-novo">Novo</span></td>
                                <td><strong>R$ 150</strong></td>
                                <td><a href="#" class="action-link">Detalhes</a></td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Instalação de Torneira</strong>
                                    <span class="job-id">JOB-102</span>
                                </td>
                                <td>Maria Oliveira</td>
                                <td>Amanhã, 09:00</td>
                                <td><span class="status-badge status-novo">Novo</span></td>
                                <td><strong>R$ 120</strong></td>
                                <td><a href="#" class="action-link">Detalhes</a></td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Detecção de Vazamento</strong>
                                    <span class="job-id">JOB-899</span>
                                </td>
                                <td>Pedro Santos</td>
                                <td>Hoje, 10:00</td>
                                <td><span class="status-badge status-andamento">Andamento</span></td>
                                <td><strong>R$ 250</strong></td>
                                <td><a href="#" class="action-link">Detalhes</a></td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Desentupimento</strong>
                                    <span class="job-id">JOB-895</span>
                                </td>
                                <td>Ana Costa</td>
                                <td>Ontem</td>
                                <td><span class="status-badge status-concluido">Concluído</span></td>
                                <td><strong>R$ 180</strong></td>
                                <td><a href="#" class="action-link">Detalhes</a></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>

        </main>

    <%- include ('./partials/footer') %>
    </section>
</body>

</html>
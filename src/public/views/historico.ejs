<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Links Css -->
    <link rel="stylesheet" href="../styles/historico.css"">
    <link rel="stylesheet" href="styles/global.css">
    <link rel="stylesheet" href="styles/navBar.css">
    <link rel="stylesheet" href="styles/footer.css">

    <!-- CDN font-awesome e Google Fontes-->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <title>ConectaServ - Histórico de Serviços</title>
    
</head>
<body>

    <section class="container">
        <!-- Header -->
            <% if (usuario && usuario.perfil === 'cliente') { %>
                <%- include('partials/headerCliente') %>
            <% } else if (usuario && usuario.perfil === 'prestador') { %>
                <%- include('partials/headerColaborador') %>
            <% } else { %>
                <p><a href="/login">Por favor, faça login para acessar.</a></p>
            <% } %>
    
        <!-- Estrutura Principal -->
        <main class="layout-container">

            <!-- Área Central (Histórico de Serviços) -->
            <section class="content-area">
                <div class="history-card-container">
                    <h2>Histórico de Serviços</h2>
                    
                    <div class="orders-list">
                        
                        <!-- Card 1: Em Andamento -->
                        <article class="order-card">
                            <div class="order-header">
                                <div>
                                    <div class="order-meta">
                                        <span class="order-id">ORD-8492</span>
                                        <span class="status-badge status-andamento">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                                            Em andamento
                                        </span>
                                    </div>
                                    <h3 class="service-title">Conserto de Vazamento - Pia</h3>
                                    <div class="service-date">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                        15 Out 2026
                                    </div>
                                </div>
                                <div class="order-price-block">
                                    <p class="price-label">Valor Total</p>
                                    <p class="price-value">R$ 189.00</p>
                                </div>
                            </div>
                            <div class="order-footer">
                                <div class="professional-info">
                                    <div class="pro-avatar">C</div>
                                    <span class="pro-name">Carlos Ferreira</span>
                                </div>
                                <div class="order-actions">
                                    <button class="btn-action btn-details">Ver Detalhes</button>
                                </div>
                            </div>
                        </article>
    
                        <!-- Card 2: Concluído -->
                        <article class="order-card">
                            <div class="order-header">
                                <div>
                                    <div class="order-meta">
                                        <span class="order-id">ORD-7311</span>
                                        <span class="status-badge status-concluido">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                                            Concluído
                                        </span>
                                    </div>
                                    <h3 class="service-title">Instalação de Chuveiro</h3>
                                    <div class="service-date">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                        02 Set 2026
                                    </div>
                                </div>
                                <div class="order-price-block">
                                    <p class="price-label">Valor Total</p>
                                    <p class="price-value">R$ 120.00</p>
                                </div>
                            </div>
                            <div class="order-footer">
                                <div class="professional-info">
                                    <div class="pro-avatar">M</div>
                                    <span class="pro-name">Mariana Silva</span>
                                </div>
                                <div class="order-actions">
                                    <button class="btn-action btn-rate">Avaliar</button>
                                    <button class="btn-action btn-details">Ver Detalhes</button>
                                </div>
                            </div>
                        </article>
    
                        <!-- Card 3: Cancelado -->
                        <article class="order-card">
                            <div class="order-header">
                                <div>
                                    <div class="order-meta">
                                        <span class="order-id">ORD-6520</span>
                                        <span class="status-badge status-cancelado">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
                                            Cancelado
                                        </span>
                                    </div>
                                    <h3 class="service-title">Pintura de Quarto</h3>
                                    <div class="service-date">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                        28 Ago 2026
                                    </div>
                                </div>
                                <div class="order-price-block">
                                    <p class="price-label">Valor Total</p>
                                    <p class="price-value">R$ 450.00</p>
                                </div>
                            </div>
                            <div class="order-footer">
                                <div class="professional-info">
                                    <div class="pro-avatar" style="background-color: var(--bg); color: var(--text-light);">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                                    </div>
                                    <span class="pro-name" style="color: var(--text-light);">Profissional não alocado</span>
                                </div>
                                <div class="order-actions">
                                    <button class="btn-action btn-details">Ver Detalhes</button>
                                </div>
                            </div>
                        </article>
    
                    </div>
                </div>
            </section>
    
        </main>
    </section>

    <!-- Footer -->
    <%- include ('./partials/footer') %>

</body>
</html>
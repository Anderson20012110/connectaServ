<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Links Css -->
    <link rel="stylesheet" href="../styles/home.css">
    <link rel="stylesheet" href="../styles/global.css">
    <link rel="stylesheet" href="../styles/navBar.css">
    <link rel="stylesheet" href="../styles/footer.css">

    <!-- CDN font-awesome e Google Fontes-->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <title>ConnectaServ</title>

</head>

<body>

    <section class="container">

        <%- include('./partials/header') %>
    
        <section class="hero-section">
            <div class="hero-container">
                <h1>Encontre o profissional certo,<br>perto de você.</h1>
                <p>Conectamos você aos melhores prestadores de serviço da sua região.<br>Rápido, seguro e sem
                    complicações.
                </p>

                <div class="search-bar">
                    <div class="search-input-group flex-2">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="text" placeholder="O que você precisa hoje?">
                    </div>
                    <div class="search-divider"></div>
                    <div class="search-input-group flex-1">
                        <i class="fa-solid fa-location-dot"></i>
                        <input type="text" placeholder="Recife, PE" value="Recife, PE">
                    </div>
                    <button class="btn-search">Buscar</button>
                </div>
            </div>
        </section>

        <section class="categories-section">
            <div class="box">
                <div class="section-header">
                    <div>
                        <h2>Categorias Populares</h2>
                        <p>Navegue pelos serviços mais buscados</p>
                    </div>
                    <a href="#" class="view-all">Ver todas <i class="fa-solid fa-arrow-right"></i></a>
                </div>

                <div class="categories-grid">
                    <div class="category-card">
                        <div class="cat-icon bg-blue-light">
                            <i class="fa-solid fa-wrench text-blue"></i>
                        </div>
                        <span>Reformas</span>
                    </div>
                    <div class="category-card">
                        <div class="cat-icon bg-yellow-light">
                            <i class="fa-solid fa-bolt text-yellow"></i>
                        </div>
                        <span>Elétrica</span>
                    </div>
                    <div class="category-card">
                        <div class="cat-icon bg-pink-light">
                            <i class="fa-solid fa-scissors text-pink"></i>
                        </div>
                        <span>Beleza</span>
                    </div>
                    <div class="category-card">
                        <div class="cat-icon bg-purple-light">
                            <i class="fa-solid fa-book-open text-purple"></i>
                        </div>
                        <span>Aulas</span>
                    </div>
                </div>
            </div>
        </section>

        <section class="professionals-section">
            <div class="box">
                <div class="section-header">
                    <div>
                        <h2>Profissionais perto de você</h2>
                        <p>Encontre os melhores talentos na sua região</p>
                    </div>
                </div>

                <div class="professionals-grid">

                    <% prestadores.forEach(prestador => { %>
                        <div class="pro-card">

                            <div class="pro-image-wrapper">
                                <img src="<%= prestador.foto_perfil %>" alt="<%= prestador.Usuario.nome %>" class="pro-image">
                                <button class="btn-favorite"> <i class="fa-regular fa-heart"></i></button>
                            </div>
                        
                            <div class="pro-info">
                                <div class="pro-header">
                                    <h3> <%= prestador.Usuario.nome %> </h3>
                                    <div class="pro-rating"> <i class="fa-solid fa-star"></i> 5.0 </div>
                                </div>
                            
                                <p class="pro-category"> <%= prestador.cargo %> </p>
                            
                                <div class="pro-meta">
                                    <span><i class="fa-solid fa-map-pin"></i> <%= prestador.cidade %> - <%= prestador.estado %> </span>
                                </div>
                            
                                <div class="pro-footer">
                                    <strong> R$ <%= prestador.preco_base %> </strong>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        </section>

        <section class="cta-section">
            <div class="box text-center">
                <h2>É um profissional autônomo?</h2>
                <p>Junte-se a milhares de profissionais que estão aumentando sua renda com a ConectaServ. Cadastro 100%
                    gratuito.</p>
                <button class="btn-white">Quero oferecer meus serviços</button>
            </div>
        </section>

        <%- include ('./partials/footer') %>
    </section>
</body>

</html>
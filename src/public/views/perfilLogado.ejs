<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Links Css -->
    <link rel="stylesheet" href="../styles/perfil-logado.css">
    <link rel="stylesheet" href="/styles/global.css">
    <link rel="stylesheet" href="/styles/navBar.css">
    <link rel="stylesheet" href="/styles/footer.css">

    <!-- CDN font-awesome e Google Fontes-->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <title>Perfil</title>

</head>

<body>
    <section class="container">

            <% if (usuario && usuario.perfil === 'cliente') { %>
                <%- include('partials/headerCliente') %>
            <% } else if (usuario && usuario.perfil === 'prestador') { %>
                <%- include('partials/headerColaborador') %>
            <% } else { %>
                <p><a href="/login">Por favor, faça login para acessar.</a></p>
            <% } %>

        <%
            let target = prestador || perfilUsuario;
            let foto = target && target.foto_perfil ? target.foto_perfil : '';
            let nome = target && target.Usuario ? target.Usuario.nome : 'Usuário';
            let cidade = target && target.cidade ? target.cidade : 'Não informada';
            let estado = target && target.estado ? target.estado : '';
            let rua = target && target.rua ? target.rua : '';
            let dataCriacao = target && target.createdAt ? new Date(target.createdAt).getFullYear() : '2024';
            let isPrestador = !!prestador;
            let bio = target && target.bio ? target.bio : (isPrestador ? 'Sem biografia' : 'Perfil de cliente');
            let cargo = isPrestador ? target.cargo : 'Cliente';
            let precoBase = isPrestador ? target.preco_base : 0;
            let servicos = isPrestador ? target.ServicoPrestadors : [];
        %>

        <main class="box profile-page">
            <section class="profile-header-card">
                <div class="profile-banner"></div>
                <div class="profile-main-info">
                    <div class="avatar-container">
                        <div class="avatar">
                            <% if (foto) { %>
                                <img src="<%= resolverImagem(foto) %>" alt="<%= nome %>" style="width:100%; height:100%; border-radius:50%; object-fit:cover;">
                            <% } else { %>
                                <i class="fa-solid fa-user"></i>
                            <% } %>
                            <% if (isPrestador) { %>
                            <div class="verified-badge"><i class="fa-solid fa-check"></i></div>
                            <% } %>
                        </div>
                    </div>
                    <div class="info-actions-row">
                        <div class="text-info">
                            <div class="name-rating">
                                <h1><%= nome %></h1>
                                <% if (isPrestador) { %>
                                <span class="star-badge"><i class="fa-solid fa-star"></i> 4.9</span>
                                <% } %>
                            </div>
                            <p class="job-title"><%= cargo %></p>
                            <div class="meta-info">
                                <span><i class="fa-solid fa-location-dot"></i> <%= cidade %>, <%= estado %></span>
                                <span><i class="fa-regular fa-calendar"></i> Na plataforma desde <%= dataCriacao %></span>
                                <% if (isPrestador) { %>
                                <span><i class="fa-regular fa-comment"></i> 124 avaliações</span>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- <nav class="profile-tabs">
                <button class="tab-item active" onclick="showTab('sobre')">Sobre</button>
                <button class="tab-item" onclick="showTab('meusCartoes')">Meus Cartões</button>
            </nav> -->

            <div class="profile-content-grid">
                <section class="main-content">
                    <div id="tab-sobre" class="content-card tab-content">
                        <h2>Meus dados</h2>
                        <div class="parent">
                            <div><i class="fa-solid fa-pen-to-square"></i>+55 (81) 9999-9999 </div>
                            <div><i class="fa-solid fa-pen-to-square"></i><%= rua %> ,  <%= cidade %> ,  <%= estado %></div>
                        </div>

                    </div>

                    <!-- <div id="tab-portfolio" class="content-card tab-content" style="display: none;">
                        <h2>Meus Cartões</h2>
                        <div class="portfolio-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1rem;">
                            <div class="portfolio-item" style="height: 150px; background: #eee; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                                <span style="color: #999;">Projeto 1</span>
                            </div>
                            <div class="portfolio-item" style="height: 150px; background: #eee; border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                                <span style="color: #999;">Projeto 2</span>
                            </div>
                        </div>
                    </div> -->

                </section>

                <aside class="sidebar">
                    <% if (isPrestador) { %>
                    <div class="price-card">
                        <h3>Tabela de Preços</h3>
                        <div class="base-price-box">
                            <span class="label">Preço base</span>
                            <span class="value">A partir de R$ <%= precoBase %></span>
                        </div>
                        <ul class="price-list">
                            <% if (servicos && servicos.length > 0) { %>
                                <% servicos.forEach(servico => { %>
                                    <li><span><%= servico.nome %></span> <strong>R$ <%= servico.valor %></strong></li>
                                <% }) %>
                            <% } else { %>
                                <li><span>Nenhum serviço</span></li>
                            <% } %>
                        </ul>
                        <button class="btn-budget-request">Solicitar Orçamento</button>
                        <p class="price-disclaimer">O valor final pode variar após a avaliação no local.</p>
                    </div>
                    <% } %>
                </aside>
            </div>
        </main>

        <%- include('partials/footer') %>
    </section>
<!-- 
    <script>
        function showTab(tabName) {
            document.querySelectorAll('.tab-content').forEach(el => el.style.display = 'none');
            document.querySelectorAll('.tab-item').forEach(el => el.classList.remove('active'));
            
            document.getElementById('tab-' + tabName).style.display = 'block';
            event.target.classList.add('active');
        }
    </script> -->
</body>

</html>
<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Links Css -->
    <link rel="stylesheet" href="/styles/search.css">
    <link rel="stylesheet" href="styles/global.css">
    <link rel="stylesheet" href="styles/navBar.css">
    <link rel="stylesheet" href="styles/footer.css">

    <!-- Link Css do leaflet -->
     <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
     integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
     crossorigin=""/>
    
     <!-- Link Js do leaflet-->
     <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
     integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
     crossorigin=""></script>

    <!-- Link Js -->
    <script src="/scripts/resolverImagem.js" defer></script>
    <script src="/scripts/mapa.js" defer></script>

    <!-- CDN font-awesome e Google Fontes-->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <title>ConectaServ - Busca de Profissionais</title>

</head>

<body>
    <section class="container">
            <% if (usuario && usuario.perfil === 'cliente') { %>
                <%- include('partials/headerCliente') %>
            <% } else if (usuario && usuario.perfil === 'prestador') { %>
                <%- include('partials/headerColaborador') %>
            <% } else { %>
                <p><a href="/login">Por favor, faça login para acessar.</a></p>
            <% } %>

        <main class="main-content">
            <aside class="sidebar">
                <div class="search-container">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--text-light)"
                        stroke-width="2">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input type="text" id="searchInput" placeholder="Buscar serviços..." class="search-input">
                    <button class="filter-btn" id="btnSearch" title="Buscar">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--text-gray)"
                            stroke-width="2">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                    </button>
                </div>

                <div class="box-serach-endereco">
                    <i class="fa-solid fa-location-dot"></i>
                    <p id="txt-end">Localizando...</p>
                </div>

                <div class="results-header">
                    <span class="results-count" id="resultsCount">Buscando profissionais...</span>
                    <button class="sort-btn">↑↓ Relevância</button>
                </div>

                <div class="cards-list" id="cardsList">
                    <p class="cards-empty" id="cardsEmpty" style="display:none;">Nenhum profissional encontrado para essa busca.</p>
                </div>
            </aside>

            <div id="map" class="map-area"></div>

        </main>

        <%- include ('./partials/footer') %>
    </section>
</body>

</html>